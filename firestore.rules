rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Inventory items collection
    match /inventory_items/{itemId} {
      allow read, write: if true;
    }

    // School settings collection
    match /school_settings/{settingId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // System metadata collection
    match /system_metadata/{metaId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // Catch-all deny for unlisted documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

